# Lauren Intelligence Dashboard — Client Environment Variables
# Copy this file to .env.local for local dev, or set these in Vercel dashboard.

# Backend API URL (Render deployment).
# In local dev, leave this unset — Vite proxy handles /api → localhost:5000
# In production (Vercel), set this to your Render backend URL:
VITE_API_URL=https://lauren-dashboard-api.onrender.com/api
