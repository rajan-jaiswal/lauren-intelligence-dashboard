# Lauren Intelligence Dashboard — Server Environment Variables
# Copy this file to .env and fill in your actual values

# MongoDB connection string (local)
MONGO_URI=mongodb://localhost:27017/lauren-dashboard

# Google Gemini API key — get yours at https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# Server port
PORT=5000

# Admin PIN for the "Add Product" page (4-6 digits recommended)
ADMIN_PIN=1234
