# Lauren Intelligence Dashboard — Server Environment Variables
# Copy this file to .env and fill in your actual values.
# On Render: set these in the Environment tab of your web service.

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxxx.mongodb.net/lauren-dashboard?retryWrites=true&w=majority

# Google Gemini API key (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server port (Render sets this automatically)
PORT=5000

# Admin PIN for Add Product / Manage Practices pages
ADMIN_PIN=your-pin-here

# Your Vercel frontend URL — used for CORS allow-list
# e.g. https://lauren-intelligence-dashboard.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Render sets this automatically — used for keep-alive self-ping
# RENDER_EXTERNAL_URL=https://lauren-dashboard-api.onrender.com
